# .easignore controls what EAS Build uploads. When present it REPLACES
# .gitignore for upload purposes, so it must re-list everything we don't want
# on the build servers — but it intentionally does NOT ignore
# google-services.json, so that (gitignored) file reaches the Android build,
# where app.json's android.googleServicesFile points at it.
#
# Still excluded here: .env* (Supabase/Sentry config comes from EAS env vars)
# and the FCM service-account key (uploaded to EAS credentials, must never
# ship inside the app).

# Dependencies
node_modules/
yarn.lock
.pnp/
.pnp.js
.npm
/deno.lock
legacy/**/package-lock.json

# Expo
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# Native build outputs (generated by expo prebuild)
/ios
/android
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Push credentials — NOT google-services.json (that one must upload):
GoogleService-Info.plist
fcm-service-account*.json

# Environment variables — provided to the build via EAS env vars
.env
.env*.local
.env.local.qa-bak

# TypeScript
*.tsbuildinfo

# Logs / debug
logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Runtime
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output

# Caches
.eslintcache
.node_repl_history

# Output of 'npm pack'
*.tgz
.yarn-integrity

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Supabase local dev
supabase/.branches
supabase/.temp

# Local-only docs / unrelated projects
prompts/
CLAUDE.md
web/
qa/
.superpowers/
